---
export const prerender = false;

import { env as runtimeEnv } from "cloudflare:workers";
import ForumLayout from "../../layouts/ForumLayout.astro";
import { createSSRClient, type CloudflareEnv } from "../../lib/supabase-server";
import CommentsSection from "../../components/forum/CommentsSection";
import PostModerationActions from "../../components/forum/PostModerationActions";
import PostMediaGallery from "../../components/forum/PostMediaGallery";
import PostSocialActions from "../../components/forum/PostSocialActions";
import { buildLoginHref } from "../../lib/auth-redirect";
import { formatCommunityPostTime } from "../../lib/i18n/messages/community";
import { resolveLocale } from "../../lib/i18n/locale";
import { getUiMessages, formatUiMessage } from "../../lib/i18n/catalog";
import { resolveSignedPostMedia, type PostMediaRow } from "../../lib/forum-media";
import { buildPostLikeCountMap, safeIncrementPostViewCount } from "../../lib/post-engagement";
import { sanitizeBodyForDisplay } from "../../lib/post-body";
import { buildProfileHref } from "../../lib/profile-links";
import { resolveProfileAvatarUrl } from "../../lib/profile-media";
import { discussionSchema, serializeJsonLd } from "../../lib/seo";
import { resolveSiteOrigin } from "../../lib/site-origin";

// The posts foreign keys target single profiles/circles rows; either join may be hidden by RLS.
type PostDetailRow = {
  id: string;
  author_id: string;
  title: string;
  body: string;
  type: string;
  status: string;
  moderation_status: string | null;
  created_at: string;
  updated_at: string;
  profiles: { display_name: string | null; username: string | null; avatar_url: string | null } | null;
  circles: { slug: string; name: string } | null;
};

const { id } = Astro.params;
const localeContext = Astro.locals.localeContext ?? resolveLocale({});
const text = getUiMessages(localeContext.locale).community;

if (!id) {
  return Astro.redirect("/feed/?sort=latest");
}

const env = runtimeEnv as CloudflareEnv;
const supabase = createSSRClient(env);
const r2PublicBaseUrl = env.R2_PUBLIC_BASE_URL || "";

const { data: post, error } = await supabase
  .from("posts")
  .select("id, author_id, title, body, type, status, moderation_status, created_at, updated_at, profiles:author_id(display_name,username,avatar_url), circles:circle_id(slug, name)")
  .eq("id", id)
  .eq("status", "published")
  .eq("moderation_status", "published")
  .single()
  .overrideTypes<PostDetailRow, { merge: false }>();

const { data: mediaRows } = !error && post
  ? await supabase
      .from("post_media")
      .select("*")
      .eq("post_id", id)
      .order("sort_order", { ascending: true })
      .order("created_at", { ascending: true })
  : { data: [] as Array<{
      id: string;
      kind: "image" | "video" | "video_link";
      url: string | null;
      storage_path: string | null;
      thumbnail_url: string | null;
      alt_text: string | null;
      width: number | null;
      height: number | null;
      duration_seconds: number | null;
      size_bytes: number | null;
      mime_type: string | null;
      sort_order: number;
      is_cover: boolean | null;
    }> };

if (error || !post) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

const postTypeLabels: Record<string, string> = text.types;

const circle = post?.circles ?? null;
const canonicalUrl = post ? `/posts/${post.id}/` : undefined;
const commentLoginHref = buildLoginHref(post ? `/posts/${post.id}/#comments` : "/feed/?sort=latest");
const postMedia = await resolveSignedPostMedia(
  supabase,
  (mediaRows ?? []) as PostMediaRow[],
  60 * 60,
  r2PublicBaseUrl,
  { publicProxy: true },
);
const likeCountMap = post ? await buildPostLikeCountMap(supabase, [post.id]) : new Map();
const initialLikeCount = post ? likeCountMap.get(post.id) ?? 0 : 0;
const displayBody = sanitizeBodyForDisplay(post?.body);
const authorHref = post ? buildProfileHref({ id: post.author_id, username: post.profiles?.username ?? null }) : null;
const authorAvatarUrl = post
  ? await resolveProfileAvatarUrl(supabase, post.profiles?.avatar_url ?? null, undefined, {
      publicProxyUserId: post.author_id,
    })
  : null;
const authorName = post
  ? post.profiles?.display_name?.trim()
    || post.profiles?.username?.trim()
    || `${post.author_id.slice(0, 6)}…${post.author_id.slice(-4)}`
  : text.anonymous;
const authorInitial = authorName.trim().charAt(0).toUpperCase() || "U";
const schema = post ? discussionSchema({ post, text: displayBody ?? '',
  url: new URL(`/posts/${post.id}/`, resolveSiteOrigin(Astro.site?.origin)).href,
  authorName: post.profiles?.display_name?.trim() || post.profiles?.username?.trim() || undefined,
}) : undefined;
if (post) {
  await safeIncrementPostViewCount(supabase, post.id);
}
---

{!post ? (
  <ForumLayout title={text.postNotFound} noindex={true}>
    <div class="forum-empty">
      <strong>{text.postNotFound}</strong>
      <p>{text.postNotFoundDetail}</p>
      <a href="/feed/?sort=latest" class="forum-btn">{text.backFeed}</a>
    </div>
  </ForumLayout>
) : (
  <ForumLayout
    title={post.title}
    description={displayBody ? displayBody.substring(0, 160).replace(/[#*\n]/g, ' ').trim() : undefined}
    canonical={canonicalUrl}
    ogType="article"
    activeTab="feed"
  >
    {schema && <script is:inline type="application/ld+json" set:html={serializeJsonLd({ '@context': 'https://schema.org', ...schema })} />}
    <nav class="community-breadcrumb" aria-label={text.breadcrumb}>
      <a href="/">{text.home}</a>
      <span class="community-breadcrumb__sep">/</span>
      <a href="/feed/?sort=latest">{text.forum}</a>
      <span class="community-breadcrumb__sep">/</span>
      {circle && (
        <>
          <a href={`/circles/${circle.slug}/`}>{circle.name}</a>
          <span class="community-breadcrumb__sep">/</span>
        </>
      )}
      <span class="community-breadcrumb__current">{post.title}</span>
    </nav>

    <article class="post-detail">
      <header class="post-detail__header">
        <div class="post-detail__meta-row">
          {post.type && (
            <span class="forum-tag">{postTypeLabels[post.type] || post.type}</span>
          )}
          {circle && (
            <a href={`/circles/${circle.slug}/`} class="forum-tag forum-tag--muted post-detail__circle-link">
              {circle.name}
            </a>
          )}
        </div>
        <h1 class="post-detail__title">{post.title}</h1>
        <div class="post-detail__author-block">
          {authorHref ? (
            <a href={authorHref} class="post-detail__author-avatar" aria-label={formatUiMessage(text.viewProfile, { name: authorName })}>
              {authorAvatarUrl ? <img src={authorAvatarUrl} alt="" loading="lazy" /> : <span>{authorInitial}</span>}
            </a>
          ) : (
            <span class="post-detail__author-avatar" aria-hidden="true">
              {authorAvatarUrl ? <img src={authorAvatarUrl} alt="" loading="lazy" /> : <span>{authorInitial}</span>}
            </span>
          )}
          <div class="post-detail__author-copy">
            <div class="post-detail__author-heading">
              {authorHref ? (
                <a href={authorHref} class="post-detail__author-link">{authorName}</a>
              ) : (
                <span class="post-detail__author-link">{authorName}</span>
              )}
            </div>
            <div class="forum-meta post-detail__meta">
              <span>{formatCommunityPostTime(post.created_at, localeContext.locale)}</span>
            </div>
          </div>
        </div>
      </header>

      <section class="post-body-card">
        {displayBody ? (
          <div class="post-body-card__content">{displayBody}</div>
        ) : (
          <p class="post-body-card__empty">{text.noBody}</p>
        )}
      </section>

      {postMedia.length > 0 && <PostMediaGallery media={postMedia} postTitle={post.title} localeContext={localeContext} client:load />}

      <div class="post-detail__actions">
        <a href="/feed/?sort=latest" class="community-action-button">{text.backFeed}</a>
        <PostSocialActions postId={post.id} initialLikeCount={initialLikeCount} localeContext={localeContext} client:visible />
        <PostModerationActions postId={post.id} authorId={post.author_id} localeContext={localeContext} client:load />
      </div>
    </article>

    <section id="comments">
      <CommentsSection postId={post.id} postAuthorId={post.author_id} loginHref={commentLoginHref} localeContext={localeContext} client:visible />
    </section>

  </ForumLayout>
)}

<style>
  .post-detail {
    max-width: 860px;
  }
  .post-detail__header {
    margin-bottom: 1.35rem;
  }
  .post-detail__meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.7rem;
    flex-wrap: wrap;
  }
  .post-detail__circle-link {
    text-decoration: none;
  }
  .post-detail__title {
    margin: 0 0 0.7rem;
    font-size: clamp(1.65rem, 3vw, 2rem);
    line-height: 1.24;
  }
  .post-detail__meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.84rem;
  }
  .post-detail__author-block {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .post-detail__author-avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(242, 244, 245, 0.88);
    font-weight: 600;
  }
  .post-detail__author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .post-detail__author-copy {
    min-width: 0;
  }
  .post-detail__author-heading {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin-bottom: 0.2rem;
  }
  .post-detail__author-link {
    color: rgba(242, 244, 245, 0.88);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .post-detail__author-link:hover {
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.28);
  }
  .post-body-card {
    padding: 0 0 0.2rem;
  }
  .post-body-card__content {
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.78;
    font-size: 1rem;
    color: var(--text);
  }
  .post-body-card__empty {
    color: var(--text-muted);
    font-style: italic;
  }
  .post-moderation-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .post-detail__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }
  .post-detail__actions :global(.community-action-button) {
    min-height: 30px;
    padding: 0.32rem 0.72rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.08);
    color: rgba(242, 244, 245, 0.72);
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .post-detail__actions :global(.community-action-button--social.is-liked) {
    color: #f06b7f;
    border-color: rgba(240, 107, 127, 0.22);
  }
  .post-detail__actions :global(.community-action-button--social.is-liked .community-like-heart) {
    color: #f06b7f;
  }
  .post-detail__actions :global(.community-action-button:hover) {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.12);
    color: rgba(242, 244, 245, 0.92);
  }
  .post-detail__actions :global(.community-action-button--danger) {
    color: rgba(255, 205, 205, 0.78);
    border-color: rgba(231, 176, 176, 0.12);
  }
  .post-detail__actions :global(.post-moderation-actions) {
    display: contents;
  }
  .post-detail__actions :global(.community-social-actions) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
</style>
