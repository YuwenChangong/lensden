---
export const prerender = false;

import type { MDXInstance } from "astro";
import CommunityLayout from "../../layouts/CommunityLayout.astro";
import { articleSchema, breadcrumbSchema, validSeoDate } from "../../lib/seo";
import { resolveSiteOrigin } from "../../lib/site-origin";
import { resolveDocumentLocale } from "../../lib/i18n/document-locale";
import { selectEditorialVariant } from "../../lib/i18n/editorial-variants";

type GuideEntry = Pick<MDXInstance<{ title: string; description?: string; draft?: boolean; language?: "en" | "zh-CN"; published_at?: string; lastUpdated?: string | Date }>, "default" | "frontmatter">;

const slug = Astro.params.slug ?? "";
const modules = import.meta.glob<GuideEntry>("../../content/docs/guides/*.mdx");
const englishModules = import.meta.glob<GuideEntry>("../../content/editorial-translations/en/guides/*.mdx");
const loadEntry = modules[`../../content/docs/guides/${slug}.mdx`]
  ?? englishModules[`../../content/editorial-translations/en/guides/${slug}.mdx`];

if (!loadEntry) {
  return Astro.rewrite('/404/');
}

const documentLocale = resolveDocumentLocale(Astro.url.searchParams.get("lang"), Astro.locals.localeContext.locale);
const selection = selectEditorialVariant(`guides/${slug}`, documentLocale);
const reviewedModules = {
  "/src/content/editorial-translations/en/guides/index.mdx": () => import("../../content/editorial-translations/en/guides/index.mdx"),
};
const reviewedLoader = Object.hasOwn(reviewedModules, selection.moduleKey)
  ? reviewedModules[selection.moduleKey as keyof typeof reviewedModules] : undefined;
const entry = (await (reviewedLoader ? reviewedLoader() : loadEntry())) as GuideEntry;
if (entry.frontmatter.draft) return Astro.rewrite('/404/');

const Content = entry.default;
import { getUiMessages } from "../../lib/i18n/catalog";
const text = getUiMessages(Astro.locals.localeContext.locale).documents;
const origin = resolveSiteOrigin(Astro.site?.origin);
const updatedAt = validSeoDate(entry.frontmatter.lastUpdated);
const publishedAt = validSeoDate(entry.frontmatter.published_at);
const contentLocale = entry.frontmatter.language ?? selection.locale;
---

<CommunityLayout
  title={entry.frontmatter.title}
  description={entry.frontmatter.description}
  canonical={`/guides/${slug}/`}
  activeSection="products"
  ogType="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  structuredData={[
    articleSchema({ title: entry.frontmatter.title, description: entry.frontmatter.description, url: new URL(`/guides/${slug}/`, origin).href, publishedAt, updatedAt }),
    breadcrumbSchema([{ name: text.guides, url: new URL('/guides/', origin).href }, { name: entry.frontmatter.title, url: new URL(`/guides/${slug}/`, origin).href }]),
  ]}
>
  <section class="community-page-head">
    <div>
      <h1>{entry.frontmatter.title}</h1>
      {entry.frontmatter.description && <p class="community-page-lead">{entry.frontmatter.description}</p>}
      {publishedAt && <p class="community-meta">{contentLocale === "en" ? "Published" : "发布于"} <time datetime={publishedAt}>{publishedAt.slice(0, 10)}</time></p>}
      {updatedAt && <p class="community-meta"><time datetime={updatedAt}>{updatedAt.slice(0, 10)}</time></p>}
    </div>
  </section>

  <section class="community-grid">
    <article class="community-surface community-surface--padded detail-main" lang={contentLocale}>
      {contentLocale === "zh-CN" && contentLocale !== documentLocale && <p class="community-meta" role="note">{text.originalChinese}</p>}
      <Content />
    </article>
    <aside class="community-sidebar">
      <section class="community-surface community-surface--padded">
        <div class="community-page-lead" style="margin-bottom: 0.4rem;">{text.continueBrowsing}</div>
        <div class="community-list" style="padding: 0;">
          <a class="community-list-item community-link-row" href="/guides/">
            <strong>{text.backToGuides}</strong>
            <span>{text.backHint}</span>
          </a>
          <a class="community-list-item community-link-row" href="/products/">
            <strong>{text.viewProducts}</strong>
            <span>{text.productsHint}</span>
          </a>
          <a class="community-list-item community-link-row" href="/feed/">
            <strong>{text.forum}</strong>
            <span>{text.forumHint}</span>
          </a>
        </div>
      </section>
    </aside>
  </section>
</CommunityLayout>

<style>
  .detail-main :global(h2) {
    margin: 1.3rem 0 0.6rem;
    font-size: 1.12rem;
    color: var(--text);
  }
  .detail-main :global(h3) {
    margin: 1rem 0 0.45rem;
    font-size: 0.98rem;
    color: var(--text);
  }
  .detail-main :global(p),
  .detail-main :global(li) {
    color: var(--text-muted);
    line-height: 1.7;
  }
  .detail-main :global(ul) {
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
  }
  .detail-main :global(a) {
    color: rgba(242, 244, 245, 0.78);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    padding-bottom: 1px;
    transition: color 140ms ease, border-color 140ms ease;
  }
  .detail-main :global(a:hover) {
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.32);
  }
</style>
